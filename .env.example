# ==============================================================================
# Revancex — Environment Variables
# All project configuration (apps, patches, sources, build settings) is defined
# automatically in config/*.yaml. Only secrets / system overrides belong here.
# ==============================================================================

# GitHub Personal Access Token (optional, prevents API rate limiting when fetching releases)
GITHUB_TOKEN=ghp_your_github_token_here

# Keystore password for signing patched APKs (default: revanced)
KEYSTORE_PASSWORD=666

# Telegram Bot Notification credentials (optional, sends release notification after build)
TG_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TG_CHAT=-1001234567890
# Optional: Forum topic/thread ID for supergroups (leave empty for general chat)
TG_TOPIC=42
