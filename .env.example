# ==============================================================================
# ReVanceX — Environment Variables
# All project configuration (apps, patches, sources, build settings) is defined
# automatically in config/*.yaml. Only secrets / system overrides belong here.
# ==============================================================================

# GitHub Personal Access Token (optional, prevents API rate limiting when fetching releases)
GITHUB_TOKEN=ghp_your_github_token_here

# GitLab Personal Access Token (optional, prevents API rate limits on gitlab-hosted sources)
# GITLAB_TOKEN=glpat-your_gitlab_token_here

# Keystore configuration for signing patched APKs
KEYSTORE_PASSWORD=666
# KEYSTORE_FILE=keys/custom.jks
# KEYSTORE_B64=base64_encoded_keystore_for_ci_here

# Telegram Bot Notification credentials (optional, sends release notification after build)
TG_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TG_CHAT=-1001234567890
# Optional: Forum topic/thread ID for supergroups (leave empty for general chat)
TG_TOPIC=42

# Network & Bypass services (optional)
# FLARESOLVERR_URL=http://localhost:8191/v1
# TRAWL_URL=http://localhost:8000

# Smoke testing override (optional, 1 = force static manifest/DEX testing without ADB device)
# REVANCEX_STATIC_TEST=1

# Circuit breaker tuning overrides (optional)
# REVANCEX_CB_THRESHOLD=3
# REVANCEX_CB_COOLDOWN_SECS=60

# Workspace directory overrides (optional)
# REVANCEX_CONFIG_DIR=./config
# REVANCEX_TEMP_DIR=./tmp
